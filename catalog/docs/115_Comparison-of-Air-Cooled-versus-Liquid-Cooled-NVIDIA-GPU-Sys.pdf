         <dc:format>application/postscript</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Modern and trendy abstract background. Geometric texture with seamless patterns for your design (colors used: white, gray). Vector Illustration (EPS10, well layered and grouped), wide format (2:1). Easy to edit, manipulate, resize or colorize.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Abstract bright white background - Geometric texture</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Bgblue (bgblue.com)</rdf:li>
            </rdf:Seq>
         </dc:creator>
